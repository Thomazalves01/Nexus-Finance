# Copie para .env e preencha localmente. NUNCA publique o .env.
APP_ENV=development
NEXUS_PASSWORD=use-uma-senha-forte-com-12-caracteres-ou-mais
FLASK_SECRET_KEY=gere-uma-chave-aleatoria-com-mais-de-32-caracteres
SESSION_COOKIE_SECURE=0
NEXUS_DB_PATH=nexus.db
WHATSAPP_VERIFY_TOKEN=crie-uma-frase-secreta-longa-aqui
WHATSAPP_ACCESS_TOKEN=token-temporario-da-meta
WHATSAPP_PHONE_NUMBER_ID=id-do-numero-de-teste-ou-producao
# Número pessoal autorizado, apenas dígitos: código do país + DDD + número
ALLOWED_WHATSAPP_PHONE=55DDDNUMERO
# App Secret da aplicação Meta, necessário para validar X-Hub-Signature-256
META_APP_SECRET=app_secret_da_meta
WHATSAPP_GRAPH_VERSION=v22.0
PORT=5000
